{
  "name": "fincobra-mcp",
  "version": "0.1.0",
  "description": "Thin MCP server for FinCobra Checkout invoices and read-only Watchlist data.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fincobra-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "smoke": "node dist/smoke.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "25.6.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dexstandard/fincobra-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dexstandard/fincobra-mcp/issues"
  },
  "homepage": "https://github.com/dexstandard/fincobra-mcp#readme",
  "keywords": [
    "mcp",
    "fincobra",
    "checkout",
    "watchlist",
    "modelcontextprotocol"
  ],
  "publishConfig": {
    "access": "public"
  }
}
